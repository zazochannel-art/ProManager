# -----------------------------------------------------------------------------
# ProManager environment variables. Copy to .env.local and fill in.
# NEVER commit real values. Only NEXT_PUBLIC_* values are sent to the browser.
# -----------------------------------------------------------------------------

# Public (browser-safe) -------------------------------------------------------
# Supabase project URL (Project Settings → API). Local stack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Public base URL of this app (used for e-mail links and invitations).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only (never prefix with NEXT_PUBLIC_) ------------------------------------
# Secret key (sb_secret_...). Bypasses RLS. Only for trusted server code such as
# billing webhooks. Not required for the Phase 1–2 features. Leave empty if unused.
SUPABASE_SECRET_KEY=

# Transactional e-mail via Resend (optional). Without it, invitation links are
# shown to the inviting admin instead of being e-mailed.
RESEND_API_KEY=
EMAIL_FROM="ProManager <no-reply@example.com>"

# Trusted reverse proxies in front of the app, used to read the client IP for
# rate limiting from X-Forwarded-For. 1 = one platform proxy (Vercel, a single
# load balancer). 0 = the app is exposed directly (forwarding headers ignored).
TRUSTED_PROXY_HOPS=1

# Tests only ----------------------------------------------------------------------
# PostgreSQL server used by `npm run test:integration` (a throw-away database is
# created and dropped per test file). Never point this at production.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
